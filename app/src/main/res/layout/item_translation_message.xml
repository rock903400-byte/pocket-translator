<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Source Speech -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_bubble_source"
        android:orientation="vertical"
        android:padding="10dp"
        android:maxWidth="320dp">

        <TextView
            android:id="@+id/tvSourceLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="外語原文"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSourceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Original text here..."
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Translated Target Speech -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_bubble_target"
        android:orientation="vertical"
        android:padding="10dp"
        android:maxWidth="320dp">

        <TextView
            android:id="@+id/tvTargetLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="繁體中文翻譯"
            android:textColor="#FF6EE7B7"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvTargetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="翻譯中文結果..."
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
